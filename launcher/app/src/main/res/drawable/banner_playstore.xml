<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store tile: dark green field, soft glow, Phosphor "google-play-logo" fill glyph (MIT, see launcher/PHOSPHOR-LICENSE.txt). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF12261C" android:endColor="#FF060E0A" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="75dp"
                android:startColor="#446EE7A8" android:endColor="#006EE7A8" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center"
        android:drawable="@drawable/ic_glyph_playstore" />
</layer-list>
