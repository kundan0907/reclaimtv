<?xml version="1.0" encoding="utf-8"?>
<!-- tivimate tile: dark field, soft glow, Phosphor "broadcast" fill glyph (MIT, see launcher/PHOSPHOR-LICENSE.txt). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF3A1420" android:endColor="#FF12060A" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="75dp"
                android:startColor="#44FF7A8C" android:endColor="#00FF7A8C" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center"
        android:drawable="@drawable/ic_glyph_tivimate" />
</layer-list>
