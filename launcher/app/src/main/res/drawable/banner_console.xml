<?xml version="1.0" encoding="utf-8"?>
<!-- Console input tile with the PlayStation mark; see BRAND-ICONS-LICENSE.txt. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF13265A" android:endColor="#FF070D1E" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="75dp"
                android:startColor="#444C7DFF" android:endColor="#004C7DFF" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center"
        android:drawable="@drawable/ic_glyph_console" />
</layer-list>
