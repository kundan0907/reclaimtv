<?xml version="1.0" encoding="utf-8"?>
<!-- Downloader tile: deep teal field, mint arrow into a tray. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF103A3A" android:endColor="#FF061616" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="75dp"
                android:startColor="#443DDBC0" android:endColor="#003DDBC0" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center"
        android:drawable="@drawable/ic_glyph_downloader" />
</layer-list>
